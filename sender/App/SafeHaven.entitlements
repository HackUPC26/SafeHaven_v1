<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keychain access group for the token/key/pairingId stored via SecItem.
	     The $(AppIdentifierPrefix) macro is expanded by Xcode at build time. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kene.safehaven</string>
	</array>
</dict>
</plist>
