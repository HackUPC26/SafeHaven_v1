# SafeHaven relay — environment configuration.
# Copy to `.env` and adjust as needed. The relay reads these via process.env;
# in dev you can also just export them inline (e.g. `PORT=9000 npm start`).

# TCP port the HTTP + WebSocket server listens on.
PORT=8080

# Safety cap on the per-session in-memory event log (§7 / §11 of PROTOCOL.md).
# When exceeded, the OLDEST events are dropped and a truncation line is logged
# (never silent). GPS (~1/5s) and AI labels are low-rate, so a multi-hour
# incident stays well under this.
MAX_EVENT_LOG=10000
