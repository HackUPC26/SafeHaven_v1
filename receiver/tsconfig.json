{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite handles emit; tsc is used for type-checking only. */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — this is safety-critical code; keep the guardrails on. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* WebCodecs (VideoDecoder / EncodedVideoChunk / VideoFrame) live in the
       DOM lib in recent TS; "DOM" above is enough on TS 5.6+. */
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vite.config.ts"]
}
